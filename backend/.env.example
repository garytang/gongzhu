# LLM Provider API Keys
# Get your API keys from the respective providers.
# Model defaults are the cheap, fast option in each family; the commented value is the
# stronger alternative. See LLM_BOTS.md for the full table.

# Which provider fills empty seats with LLM bots: anthropic | openrouter | google.
# Unset: the first provider below with a key set, in that order. Set it explicitly when
# more than one key is present. No key at all: seats are filled with rule-based bots.
# LLM_PROVIDER=openrouter

# Anthropic Claude API
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default: claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini API
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Default: gemini-3.5-flash-lite
# GOOGLE_MODEL=gemini-3.7-flash

# OpenRouter API (supports multiple models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Default: anthropic/claude-haiku-4.5
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Log every prompt and raw model response for bot moves
# LLM_BOT_DEBUG=1

# Server Configuration
PORT=4000
CORS_ORIGIN=*
